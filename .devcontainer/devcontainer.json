{
  "name": "SciLifeLab Serve Gradio template",

  // Pin the Debian release.
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "features": {
    // Current official major version of the Docker-in-Docker feature.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },

  "remoteUser": "vscode",

  "postCreateCommand": "python -m pip install --user -r app/requirements.txt && python -m pip install --user pytest",

  "forwardPorts": [
    7860
  ],

  "portsAttributes": {
    "7860": {
      "label": "Gradio app",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "GitHub.copilot"
      ]
    }
  }
}